class Solution {
    public int maxSubArray(int[] nums) {

        int maxSub = Integer.MIN_VALUE;
        int sumCurrent = 0;

        for (int i = 0; i < nums.length; i++) {
            sumCurrent += nums[i];
            maxSub = Math.max(maxSub, sumCurrent);

            if (sumCurrent < 0) {
                sumCurrent = 0;
            }
        }
        return maxSub;
    }
}

